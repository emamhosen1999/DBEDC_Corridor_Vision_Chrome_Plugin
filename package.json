{
  "name": "corridor-vision",
  "version": "2.0.0",
  "private": true,
  "description": "DBEDC Corridor Vision \u2014 standalone 24/7 camera health monitor. Probes cameras directly (ICMP/TCP/ONVIF/RTSP/vendor/snapshot), runs as a Windows service, alerts to WhatsApp groups, Telegram, email and webhooks.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "corridor-vision": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs run",
    "dev": "node --watch src/cli.mjs run",
    "import": "node src/cli.mjs import",
    "discover": "node src/cli.mjs discover",
    "probe": "node src/cli.mjs probe",
    "test-alert": "node src/cli.mjs test-alert",
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\""
  },
  "optionalDependencies": {},
  "keywords": [
    "cctv",
    "onvif",
    "rtsp",
    "monitoring",
    "uniview",
    "whatsapp"
  ],
  "license": "UNLICENSED"
}
